# 复制为 .env 并填入你自己的值（.env 不会进 git）

# ===== LLM 供应商（三选一，留空 = volcengine，与历史行为一致）=====
# volcengine = 火山方舟 ARK；deepseek = DeepSeek 官方；openai = 任意 OpenAI 兼容网关
LLM_PROVIDER=volcengine

# --- provider=volcengine 时用这三项 ---
# 火山方舟 ARK API Key：控制台 → API Key 管理
ARK_API_KEY=your-ark-api-key
# OpenAI 兼容网关：Coding Plan 用 /api/coding/v3；平台按量用 /api/v3
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_CHAT_MODEL=deepseek-v4-flash-ga
ARK_CHAT_MODEL_FALLBACK=deepseek-v4-pro-ga

# --- provider=deepseek 时用这三项（base_url/model 有默认值，通常只需填 Key）---
# DeepSeek 官方 Key：platform.deepseek.com → API 充值
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-07-24 起 deepseek-chat / deepseek-reasoner 已下线，用下面的新名：
#   deepseek-flash（V4.1-Flash，1M 上下文，便宜、缓存命中 50 倍折扣）
#   deepseek-v4-pro（V4-Pro，更贵更强）
# DEEPSEEK_CHAT_MODEL=deepseek-flash

# --- provider=openai 时：任意 OpenAI 兼容网关（vLLM / 自建 / 第三方代理）---
# 故意不给 base_url 与 model 默认值：静默打到 api.openai.com 容易烧错钱
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_CHAT_MODEL=...

# 输出侧成本开关（留空 = 不传该参数，沿用厂商默认，行为与不加时一致）
# 三家支持的档位不同，config 会做翻译与校验：
#   volcengine/openai: minimal/low/medium/high
#   deepseek: 只有 high/max（low/medium→high，xhigh→max，minimal→关闭思考）
# LLM_REASONING_EFFORT=minimal    # 兼容旧名 ARK_REASONING_EFFORT
# LLM_THINKING=disabled           # auto/enabled/disabled（兼容 ARK_THINKING）
# 注：DeepSeek 思考模式需要回传 reasoning_content（agentscope 已处理），
#     但抽取这类结构化任务用非思考模式更省更快，建议 disabled。

# PostgreSQL / pgvector（宿主机直连用 localhost:5433）
POSTGRES_USER=moray
POSTGRES_PASSWORD=moray_dev_2026
POSTGRES_DB=moray_kb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# 注意：docker-compose.yml 里已给 api/worker 显式注入 POSTGRES_HOST=postgres、
# POSTGRES_PORT=5432（compose 内网服务名/端口），会覆盖这里的 localhost:5433，
# 所以同一份 .env 既能在宿主机用、也能在容器里用，无需手改。

# ===== docker compose 部署参数（仅 compose 读取）=====
API_PORT=8000                 # api 查询服务对外端口
WORKER_REPLICAS=2             # worker 副本数（多 worker 水平扩展）
WORKER_CONCURRENCY=2          # 单个 worker 进程内并行任务数（贴合 LLM 限流）
WORKER_LEASE_SECONDS=600      # 任务租约；需大于单任务最坏耗时（慢推理给足）

# 本地嵌入模型
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
