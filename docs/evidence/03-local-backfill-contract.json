  "model_request_schema": {
    "$defs": {
      "GeneralEntity": {
        "properties": {
          "name": {
            "description": "实体标准名称，取最正式完整的叫法",
            "title": "Name",
            "type": "string"
          },
          "type": {
            "description": "实体类型，只能取本领域枚举值之一",
            "enum": [
              "PER",
              "ORG",
              "LOC",
              "EVENT",
              "MISC"
            ],
            "title": "Type",
            "type": "string"
          },
          "aliases": {
            "description": "其他叫法/简称",
            "items": {
              "type": "string"
            },
            "title": "Aliases",
            "type": "array"
          },
          "attributes": {
            "additionalProperties": true,
            "description": "该类型专有的属性键值对；没有则空对象。\nPER 的 attributes 字段：birth_date: 字符串；title: 字符串\nORG 的 attributes 字段：founded_date: 字符串；registered_capital: 数字；legal_representative: 字符串；industry: 字符串\nEVENT 的 attributes 字段：event_date: 字符串",
            "title": "Attributes",
            "type": "object"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "title": "GeneralEntity",
        "type": "object"
      },
      "GeneralRelation": {
        "properties": {
          "head": {
            "description": "头实体的标准名称",
            "title": "Head",
            "type": "string"
          },
          "predicate": {
            "description": "关系类型，规范动词短语",
            "title": "Predicate",
            "type": "string"
          },
          "tail": {
            "description": "尾实体的标准名称",
            "title": "Tail",
            "type": "string"
          }
        },
        "required": [
          "head",
          "predicate",
          "tail"
        ],
        "title": "GeneralRelation",
        "type": "object"
      }
    },
    "properties": {
      "entities": {
        "description": "抽取出的去重实体",
        "items": {
          "$ref": "#/$defs/GeneralEntity"
        },
        "title": "Entities",
        "type": "array"
      },
      "relations": {
        "description": "有明确证据的关系三元组",
        "items": {
          "$ref": "#/$defs/GeneralRelation"
        },
        "title": "Relations",
        "type": "array"
      }
    },
    "title": "GeneralExtractionResultSlim",
    "type": "object"
  },
